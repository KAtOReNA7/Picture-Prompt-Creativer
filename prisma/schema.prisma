generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ImageAsset {
  id           String           @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  localPath    String
  publicPath   String?
  createdAt    DateTime         @default(now())
  analyses     PromptAnalysis[]
}

model PromptAnalysis {
  id             String          @id @default(cuid())
  imageId        String?
  image          ImageAsset?     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  title          String?
  styleSummary   String?
  visualSubject  String?
  composition    String?
  colorPalette   String?
  lighting       String?
  texture        String?
  eraFeeling     String?
  topicPotential String?
  reversePrompt  String?
  negativePrompt String?
  rawJson        String?
  createdAt      DateTime        @default(now())
  segments       PromptSegment[]
  fusions        PromptFusion[]
  variants       PromptVariant[]
}

model PromptSegment {
  id            String         @id @default(cuid())
  analysisId    String
  analysis      PromptAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  type          String
  label         String
  content       String
  isReplaceable Boolean        @default(false)
  replaceHint   String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
}

model PromptFusion {
  id              String         @id @default(cuid())
  analysisId      String
  analysis        PromptAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  userRequirement String
  fusedPrompt     String
  changeSummary   String?
  createdAt       DateTime       @default(now())
}

model PromptVariant {
  id                 String         @id @default(cuid())
  analysisId         String
  analysis           PromptAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  title              String
  userNote           String?
  composedPrompt     String
  negativePrompt     String?
  editedSegmentsJson String?
  source             String
  createdAt          DateTime       @default(now())
}

model GeneratedImage {
  id             String                     @id @default(cuid())
  prompt         String
  negativePrompt String?
  sourceType     String
  sourceId       String?
  model          String
  size           String
  quality        String?
  format         String?
  filename       String
  localPath      String
  publicPath     String?
  createdAt      DateTime                   @default(now())
  evaluations    GeneratedImageEvaluation[]
}

model GeneratedImageEvaluation {
  id                       String         @id @default(cuid())
  generatedImageId         String
  generatedImage           GeneratedImage @relation(fields: [generatedImageId], references: [id], onDelete: Cascade)
  overallScore             Int
  promptMatchScore         Int
  styleRetentionScore      Int?
  requirementMatchScore    Int?
  compositionScore         Int
  colorScore               Int
  lightingScore            Int
  subjectScore             Int
  commercialPotentialScore Int
  summary                  String
  strengths                String
  weaknesses               String
  improvementAdvice        String
  improvedPrompt           String
  improvedNegativePrompt   String?
  rawJson                  String?
  createdAt                DateTime       @default(now())
}
